<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="18dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/app_name"
            android:textSize="26sp"
            android:textStyle="bold"
            android:textColor="@color/text_main"
            android:paddingTop="8dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Floating mic on top of any app. Keep Gboard — text inserts into the focused field."
            android:textSize="14sp"
            android:textColor="@color/text_muted"
            android:paddingTop="4dp"
            android:paddingBottom="6dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card"
            android:padding="18dp"
            android:layout_marginTop="14dp">

            <TextView style="@style/SectionTitle" android:text="SETUP" />

            <TextView
                android:id="@+id/overlay_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Overlay permission…"
                android:textSize="13sp"
                android:textColor="@color/text_muted"
                android:paddingBottom="8dp" />

            <Button
                android:id="@+id/btn_overlay"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="Allow draw over other apps"
                android:textAllCaps="false"
                android:textColor="@color/primary"
                android:textSize="14sp"
                android:background="@drawable/btn_secondary" />

            <TextView
                android:id="@+id/a11y_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Accessibility…"
                android:textSize="13sp"
                android:textColor="@color/text_muted"
                android:paddingTop="14dp"
                android:paddingBottom="8dp" />

            <Button
                android:id="@+id/btn_a11y"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="Enable auto-insert (Accessibility)"
                android:textAllCaps="false"
                android:textColor="@color/primary"
                android:textSize="14sp"
                android:background="@drawable/btn_secondary" />

            <TextView
                android:id="@+id/mic_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Microphone…"
                android:textSize="13sp"
                android:textColor="@color/text_muted"
                android:paddingTop="14dp"
                android:paddingBottom="8dp" />

            <Button
                android:id="@+id/btn_mic"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="Grant microphone"
                android:textAllCaps="false"
                android:textColor="@color/on_primary"
                android:textSize="14sp"
                android:background="@drawable/btn_primary" />

            <Button
                android:id="@+id/btn_start_bubble"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="Show floating mic"
                android:textAllCaps="false"
                android:textColor="@color/on_primary"
                android:textSize="14sp"
                android:background="@drawable/btn_primary"
                android:layout_marginTop="14dp" />

            <Button
                android:id="@+id/btn_stop_bubble"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="Hide floating mic"
                android:textAllCaps="false"
                android:textColor="@color/primary"
                android:textSize="14sp"
                android:background="@drawable/btn_secondary"
                android:layout_marginTop="10dp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card"
            android:padding="18dp"
            android:layout_marginTop="14dp">

            <TextView style="@style/SectionTitle" android:text="VOICE" />

            <TextView style="@style/FieldLabel" android:text="Language" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:baselineAligned="false">

                <Button android:id="@+id/lang_bn" style="@style/ChipPlaceholder" android:text="বাংলা" />
                <Button android:id="@+id/lang_en" style="@style/ChipPlaceholder" android:text="English" />
                <Button android:id="@+id/lang_ar" style="@style/ChipPlaceholder" android:text="العربية" />
            </LinearLayout>

            <TextView style="@style/FieldLabel" android:text="Input mode" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:baselineAligned="false">

                <Button android:id="@+id/mode_record" style="@style/ChipPlaceholder" android:text="Record" />
                <Button android:id="@+id/mode_live" style="@style/ChipPlaceholder" android:text="Live" />
            </LinearLayout>

            <TextView
                android:id="@+id/mode_help"
                style="@style/HelperText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="8dp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card"
            android:padding="18dp"
            android:layout_marginTop="14dp"
            android:layout_marginBottom="18dp">

            <TextView style="@style/SectionTitle" android:text="SERVER" />

            <TextView style="@style/FieldLabel" android:text="PWA base URL" />

            <EditText
                android:id="@+id/endpoint_input"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_input"
                android:padding="12dp"
                android:singleLine="true"
                android:textSize="14sp"
                android:textColor="@color/text_main"
                android:inputType="textUri" />

            <Button
                android:id="@+id/btn_save_endpoint"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:text="Save endpoint"
                android:textAllCaps="false"
                android:textColor="@color/on_primary"
                android:textSize="14sp"
                android:background="@drawable/btn_primary"
                android:layout_marginTop="10dp" />

            <TextView
                style="@style/HelperText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="10dp"
                android:text="Tap mic to start/stop. Long-press mic to switch Record ↔ Live. With Accessibility on, text inserts into the focused field (clipboard kept as backup)." />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
